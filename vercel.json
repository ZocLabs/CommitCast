{
  "framework": null,
  "installCommand": "node -e \"process.stdout.write('skip-install')\"",
  "buildCommand": "node -e \"process.stdout.write('skip-build')\"",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/login", "destination": "/api/login" },
    { "source": "/logout", "destination": "/api/logout" },
    { "source": "/", "destination": "/api/home" },
    { "source": "/linkedin/callback", "destination": "/api/linkedin/callback" },
    { "source": "/linkedin/start", "destination": "/api/linkedin/start" }
  ]
}
